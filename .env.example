# Copy this file to .env and fill in real credentials
PINECONE_API_KEY=your_pinecone_key
PINECONE_ENVIRONMENT=your_pinecone_environment
PINECONE_INDEX=harmony-os
HARMONY_MEMORY_MODE=production
HARMONY_LLM_MIN_DELAY_MS=500
HARMONY_LLM_MAX_RETRIES=3
HARMONY_LLM_RETRY_BACKOFF_MS=250
HARMONY_LLM_COST_PER_1K_TOKENS=0.002
HARMONY_EMBED_COST_PER_1K_TOKENS=0.0001
HARMONY_SPEAKER_ROTATION_LLM=false
HARMONY_SPEAKER_ROTATION_TIMEOUT_MS=2500
HARMONY_SENATOR_DECISION_TIMEOUT_MS=20000
HARMONY_DEBATE_LLM_TIMEOUT_MS=20000
OPENAI_API_KEY=your_openai_key
